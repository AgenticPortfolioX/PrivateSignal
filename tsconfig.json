{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node", "bun"]
  },
  "include": ["src/**/*.ts", "privatesignal/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "build"]
}
