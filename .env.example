# ==========================================
# CHAINLINK CRE WORKFLOW ENVIRONMENT TEMPLATE
# Project: PrivateSignal CRE Workflow
# ==========================================

# ------------------------------------------
# 1. Deployment Target
# ------------------------------------------
CRE_TARGET=local-simulation

# ------------------------------------------
# 2. Execution Wallet (Secret)
# ------------------------------------------
CRE_ETH_PRIVATE_KEY=your_64_character_private_key_here

# ------------------------------------------
# 3. Blockchain RPC Endpoints
# ------------------------------------------
ETH_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_key
BASE_MAINNET_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your_key
ETH_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/your_key

# ------------------------------------------
# 4. Third-Party & Signal API Integrations
# ------------------------------------------
PRIVATE_SIGNAL_API_URL=https://api.privatesignal.local/v1/feed
PRIVATE_SIGNAL_API_KEY=your_api_key_here

# ------------------------------------------
# 5. Arc Testnet (Circle L1 - Native USDC)
# ------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_AGENT_WALLET_ADDRESS=your_arc_agent_wallet_address_here
ARC_FEE_AMOUNT_USDC=0.10
AGENT_PRIVATE_KEY=your_arc_agent_private_key_here

# ------------------------------------------
# 6. Confidential Scoring (Vault DON + The Graph)
# ------------------------------------------
CRE_DON_ID=your_cre_don_id_here
VAULT_SECRET_SLOT=your_vault_secret_slot_name_here
GRAPH_API_ENDPOINT=https://api.thegraph.com/subgraphs/name/your_subgraph_here
